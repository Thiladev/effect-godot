; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Codename Painless"
run/main_scene="res://src/main/MainMenu.tscn"
config/features=PackedStringArray("4.6")

[physics]

common/physics_interpolation=true

[autoload]

GameState="*res://src/game-state/GameState.ts"
McpBridgeGame="*res://src/mcp_bridge_game.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg", "res://addons/sky_3d/plugin.cfg", "res://addons/foliage_3d/plugin.cfg", "res://addons/mcp_bridge/plugin.cfg")
