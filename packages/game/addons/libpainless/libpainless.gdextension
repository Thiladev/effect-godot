[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../libpainless/target/debug/libpainless.so"
linux.release.x86_64 = "res://../libpainless/target/release/libpainless.so"

windows.debug.x86_64 = "res://../libpainless/target/debug/painless.dll"
windows.release.x86_64 = "res://../libpainless/target/release/painless.dll"

macos.debug = "res://../libpainless/target/debug/libpainless.dylib"
macos.release = "res://../libpainless/target/release/libpainless.dylib"
