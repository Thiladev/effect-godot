{
  "name": "effect-godot",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "./README.md",
    "./AGENTS.md",
    "./src/**/*.ts",
    "./dist/**/*.js",
    "./dist/**/*.js.map",
    "./dist/**/*.d.ts",
    "./ai-docs/**/*.md"
  ],
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/Thiladev/effect-godot.git"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./GodotConfig": {
      "types": "./dist/GodotConfig.d.ts",
      "default": "./dist/GodotConfig.js"
    },
    "./GodotConnectionPool": {
      "types": "./dist/GodotConnectionPool.d.ts",
      "default": "./dist/GodotConnectionPool.js"
    },
    "./GodotCrypto": {
      "types": "./dist/GodotCrypto.d.ts",
      "default": "./dist/GodotCrypto.js"
    },
    "./GodotHttpClient": {
      "types": "./dist/GodotHttpClient.d.ts",
      "default": "./dist/GodotHttpClient.js"
    },
    "./RuntimeNode": {
      "types": "./dist/RuntimeNode.d.ts",
      "default": "./dist/RuntimeNode.js"
    },
    "./polyfill-autoload": {
      "types": "./dist/polyfill-autoload/index.d.ts",
      "default": "./dist/polyfill-autoload/index.js"
    }
  },
  "scripts": {
    "lint:tsc": "tsc -b --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "pack": "npm pack",
    "clean:cache": "rm -rf .turbo *.tsbuildinfo",
    "clean:dist": "rm -rf dist",
    "clean:modules": "rm -rf node_modules"
  },
  "dependencies": {
    "@formatjs/intl-datetimeformat": "^7.6.1",
    "@formatjs/intl-getcanonicallocales": "^3.2.11",
    "@formatjs/intl-listformat": "^8.3.13",
    "@formatjs/intl-locale": "^5.3.10",
    "@formatjs/intl-numberformat": "^9.4.0",
    "@formatjs/intl-pluralrules": "^6.3.13",
    "abort-controller": "^3.0.0",
    "text-encoding": "^0.7.0",
    "whatwg-url": "^17.1.0"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.112"
  },
  "devDependencies": {
    "effect": "^4.0.0-rc.112",
    "@types/text-encoding": "^0.0.40",
    "@types/whatwg-url": "^13.0.0"
  }
}
